{
  "name": "gmiapi-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that lets LLM clients generate images (and other media) through the GMI Cloud request-queue API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmiapi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "models.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "setup:claude": "npm run build && node scripts/install-claude-desktop.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
