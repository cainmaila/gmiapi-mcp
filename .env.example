# 必填：GMI Cloud API key（console.gmicloud.ai → API Keys）
GMI_API_KEY=

# 選填
# GMI_BASE_URL=https://console.gmicloud.ai
# GMI_DEFAULT_MODEL=gpt-image-2.6-sunburst-generate
# GMI_MODELS_FILE=./models.json
# GMI_OUTPUT_DIR=~/Pictures/gmi-mcp
# GMI_TIMEOUT_SECONDS=300
# GMI_POLL_INTERVAL_MS=2000
# 回傳給 LLM 的 inline 圖片大小上限（bytes），超過只回檔案路徑
# GMI_MAX_INLINE_BYTES=4000000
